# Cloudflare Pages: правила кэширования.
# Версионные URL (?v=h-<contenthash>, проставляется сборкой по хэшу бандлов)
# неизменяемы — браузер хранит их год, пока содержимое (и хэш) не изменится.
# Оболочка и сервис-воркер всегда ревалидируются, поэтому новый релиз
# подхватывается сразу.

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/js/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/css/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
